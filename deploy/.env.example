# Generate different random values before starting Compose.
AWS_PANEL_DB_PASSWORD=
AWS_PANEL_MIGRATION_DB_PASSWORD=
AWS_PANEL_PUBLIC_URL=http://127.0.0.1:8080
# Use a different port/image for isolated acceptance or restore projects.
AWS_PANEL_HTTP_PORT=8080
AWS_PANEL_IMAGE=aws-panel:local
# Set only the addresses/CIDRs of your trusted reverse proxy for HTTPS.
AWS_PANEL_TRUSTED_PROXIES=
# Keep disabled until the selected AWS write workflows have been validated.
AWS_PANEL_CLOUD_WRITES_ENABLED=false
# Administrator-only local task diagnostic; never issues AWS requests.
AWS_PANEL_DIAGNOSTICS=false
